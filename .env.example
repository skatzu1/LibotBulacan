# Copy to .env for local dev. .env is git-ignored.
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time, so this must
# be a *publishable* key (safe to ship) — never a secret key.
#
# For release builds, set this as an EAS secret to your Clerk PRODUCTION
# instance key (pk_live_...):  eas secret:create --name EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY

EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
