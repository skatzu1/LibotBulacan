# Copy to .env for local dev. .env is git-ignored.
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time, so these must
# be *publishable* values (safe to ship) — never a secret key.

# Optional Clerk instance override. App.js already defaults to the test instance
# for local dev and the live instance (clerk.libotbulacan.com) for release
# builds, so you only need this to point a build somewhere else — e.g. running
# a dev build against production to verify the Google consent screen.
#
#   Live:  pk_live_Y2xlcmsubGlib3RidWxhY2FuLmNvbSQ
#   Test:  pk_test_cHJpbWUtY2hpY2tlbi0yNS5jbGVyay5hY2NvdW50cy5kZXYk
#
# Never put CLERK_SECRET_KEY here — that is backend-only.
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ARCore Geospatial API key. Also set as an EAS secret for cloud builds.
ARCORE_API_KEY=
